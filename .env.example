# Supabase project URL (Project Settings → API → Project URL)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Public anon key (Project Settings → API → anon public).
# This key is safe in the browser because Row Level Security is enabled.
# NEVER put the service_role key here: it bypasses RLS.
VITE_SUPABASE_ANON_KEY=your-anon-public-key
